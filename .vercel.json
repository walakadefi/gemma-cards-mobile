{
  "buildCommand": "npx expo export --platform=web",
  "outputDirectory": ".expo/www",
  "env": {
    "EXPO_PUBLIC_NAME": "Gemma Cards"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
