      "package": "com.gemmacards.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050506"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "web": {
      "output": "static",
      "name": "GemmaCards",
      "shortName": "GemmaCards",
      "favicon": "./assets/icon.png",
      "themeColor": "#050506",
      "backgroundColor": "#050506"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd9b5e9a-128b-4448-baf4-71974f85c529"
      }
    },
    "owner": "cool_boy_11"
  }
