{
  "expo": {
    "name": "GemmaCards",
    "slug": "gemma-cards-mobile",
    "description": "Open digital trading-card packs, reveal every pull, and build your collection.",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd9b5e9a-128b-4448-baf4-71974f85c529"
    },
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gemmacards",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050506"
    },
    "ios": {
      "bundleIdentifier": "com.gemmacards.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
