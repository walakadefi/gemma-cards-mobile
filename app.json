{
  "expo": {
    "name": "GemmaCards",
    "slug": "gemma-cards-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gemmacards",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050506"
    },
    "ios": {
      "bundleIdentifier": "com.gemmacards.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gemmacards.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050506"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
